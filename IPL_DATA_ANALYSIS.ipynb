      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(\"matches.csv\")\n",
        "\n",
        "print(df.head())\n",
        "\n",
        "top_teams = df['winner'].value_counts().head(5)\n",
        "\n",
        "print(top_teams)\n",
        "\n",
        "top_teams.plot(kind='bar')\n",
        "\n",
        "plt.title(\"Top IPL Teams\")\n",
        "plt.xlabel(\"Teams\")\n",
        "plt.ylabel(\"Wins\")\n",
        "\n",
        "plt.show()"
      ]
